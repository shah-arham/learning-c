#include <stdio.h>
// program to raise a base a to a positive exponent x
int main()
{
    int base_a;
    printf("enter a base a : ");
    scanf("%d", &base_a);
    int exp_x;
    printf("enter a positive exponent x : ");
    scanf("%d", &exp_x);
    
    for(int i = 1; i < exp_x; i++)
    {
        base_a = base_a * base_a;
    }
    
    printf("%d ", base_a);
    
    return 0;
}
